<!DOCTYPE html>
<html>
    <head>
        <title>Change Password</title>
        <link rel="stylesheet" href="/stylesheets/passwordChangeStyle.css">
    </head>
    <body>
        <div id="passwordChangeFields">
            <h1>Change your Password</h1>
            <form action="/users/changeYourPassword" method="POST">
                <input type="email" name="email" placeholder="Email" required>
                <div id="passwordRequirements">
                    <div>
                        <input type="password" id="userPassword" name="password" placeholder="New Password" required>
                        <button id="passwordView">
                            <img src="/images/slashedEye.png" alt="anEye" id="showPasswordImage">
                        </button>
                    </div>
                    <div id="passwordStrengthParameters">
                        <span class="strengthParameter warningMessages">Your password must contain at least eight characters</span>
                        <span class="strengthParameter warningMessages">Your password must contain an uppercase letter</span>
                        <span class="strengthParameter warningMessages">Your password must contain a lowercase letter</span>
                        <span class="strengthParameter warningMessages">Your password must contain a digit</span>
                        <span class="strengthParameter warningMessages">Your password must contain a special character</span>
                    </div>
                </div>
                <input type="password" placeholder="Confirm New Password" id ="passwordConfirmation" required disabled>
                <input type="submit" id="passwordChangeButton" value="Change Password" disabled>
                <div id="warningMessages">
                    <span id="passwordChangingWarning"><%= message %></span>
                </div>
                <a href="/users/login">Go Back</a>
            </form>
        </div>
        <script type="module" src="/javascripts/passwordChange.js"></script>
    </body>
</html>