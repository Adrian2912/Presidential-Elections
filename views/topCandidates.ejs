<!DOCTYPE html>
<html>
    <head>
        <title>Top Candidates</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/stylesheets/topCandidates.css">
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg bg-body-tertiary">
                <ul class="nav nav-tabs">
                    <li class="nav-item active">
                        <a class="nav-link" href="/winnerCandidates">Top candidates</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/voteACandidate">Vote a candidate</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/mainProfile">Go to your profile</a>
                    </li>
                </ul>
            </nav>
        </header>
        <main class="d-flex flex-column flex-wrap justify-content-start align-items-center">
            <h1>Top Candidates</h1>
            <div id="candidatesList">
                <% if (candidatesList.length > 0) { %>
                    <ol><% for (let i = 0; i < candidatesList.length; ++i) { %>
                        <li><%= i + 1 + '.' + candidatesList[i].first_name + ' ' + candidatesList[i].last_name + ' ' + candidatesList[i].number_of_votes %></li>
                        <% } %>
                    </ol>
                <% }  else { %>
                    <h3>There are no candidates running for presidential elections</h3>
                <% } %>
            </div>
            <a id="previusElectionsList" class="nav-link text-primary" href="/previousElectionsList">Go to the previous elections</a>
        </main>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>