<!DOCTYPE html>
<html>
    <head>
        <title>Vote a candidate</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <style>
        body {
            height: 100vh;
            display: flex;
            flex-direction: column;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
        }

        body * {
            padding: 20px;
        }

        a {
            text-decoration: none;
        }

        input[type="submit"] {
            font-size: 20px;
            font-weight: bold;
            color: #fff;
            border:0;
            border-radius: 10px;
            background: #f40;
        }

        input[type="submit"]:hover {
            animation: upDown 1s infinite linear;
        }

        @keyframes upDown {
            25% {
                translate: 0 -5px;
            }

            75% {
                translate: 0 5px;
            }
        }
    </style>
    </head>
    <body>
        <h1>You have voted, cancel your vote or go back to the main page!</h1>
        <a href="/winnerCandidates">To the main page</a>
        <form action="/cancelTheVote" method="POST">
            <input type="submit" value="Cancel your vote">
        </form>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>