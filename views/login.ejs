<!DOCTYPE html>
<html>
    <head>
        <title>Login</title>
        <link rel="stylesheet" href="/stylesheets/loginStyle.css">
    </head>
    <body>
        <div id="loginFields">
            <h1>Login</h1>
            <form action="/users/logIntoAccount" method="POST">
                <input type="email" name="email" placeholder="Email" required>
                <div>
                    <input type="password" id="password" name="password" placeholder="Password" required>
                    <button id="passwordView" onmouseover="showPassword()" onmouseout="hidePassword()">
                        <img src="/images/slashedEye.png" alt="anEye" id="showPasswordImage">
                    </button>
                </div>
                <div id="warningMessages">
                    <span id="warning"><%= message %></span>
                </div>
                <input type="submit" id="loginButton" value="Login">
                <a href="/users/changePassword">Forgot Password</a>
                <a href="/">Go back</a>
            </form>
        </div>
        <script src="/javascripts/loginScript.js"></script>
    </body>
</html>