<!DOCTYPE html>
<html>
    <head>
        <title>Vote a candidate</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/stylesheets/voteYourCandidate.css">
    </head>
    <body>
        <form action="/vote" method="POST" class="d-flex flex-column flex-wrap justify-content-evenly align-items-center">
            <ul class="d-flex flex-column flex-wrap justify-content-evenly align-items-center"> <% for (let i = 0; i < candidatesList.length; ++i) {%>
                <li>
                    <%= (i + 1) + '.' + candidatesList[i].first_name + ' ' + candidatesList[i].last_name %>
                    <input type="radio" name="candidate" class="nameOfTheCandidate" onclick="voteYourCandidate()" value="<%= candidatesList[i].id %>">
                </li>
                <%}%>
            </ul>
            <input type="submit" value="Vote!" id="voteButton" disabled>
        </form>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/javascripts/candidateVoting.js"></script>
    </body>
</html>