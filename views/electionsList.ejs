<!DOCTYPE html>
<html>
    <head>
        <title>Elections List</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <style>
            body {
                height : 100vh;
            }
        </style>
    </head>
    <body class=" d-flex flex-column flex-wrap justify-content-evenly align-items-center">
        <table class="table">
            <thread>
                <tr>
                    <th scope="col">Election number</th>
                    <th scope="col">Winner's name</th>
                    <th scope="col">Number of votes</th>
                </tr>
                <tbody>
                    <% for (let i = 0; i < allPresidentialElections.length; ++i) {%>
                        <tr>
                            <th scope="row"><%= i + 1 %></th>
                            <td><%= allPresidentialElections[i].winner %></td>
                            <td><%= allPresidentialElections[i].number_of_votes %></td>
                        </tr>
                    <% } %>
                </tbody>
            </thread>
        </table>
        <a class="nav-link text-primary" href="/winnerCandidates">Go back to the main page</a>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>